            "expires_at": null,
            "kickoff_utc": "2026-10-01T13:00:00Z",
            "rights_until": null,
            "retention_seconds": 21600
          }
        ]
      },
      "expected": {
        "version": 1,
        "results": [
          {
            "id": "fresh-missing-times",
            "usable": true,
            "reason": null,
            "expires_at": null
          },
          {
            "id": "fresh-old-verification",
            "usable": true,
            "reason": null,
            "expires_at": null
          }
        ]
