{
  "version": 1,
  "description": "Independently authored TIME-WINDOW-1 complete-envelope examples; expected values are literals, not generated by the old or new implementation.",
  "cases": [
    {
      "id": "scheduled-placement",
      "request": {
        "version": 1,
        "operation": "fixture_window",
        "cases": [
          {
            "id": "future",
            "now_utc": "2026-10-23T17:00:00Z",
            "time_zone": "America/New_York",
            "kickoff_utc": "2026-10-23T18:00:00Z",
            "time_confirmed": true,
            "source_state": "pre",
            "received_at": null
          },
          {
            "id": "kickoff",
            "now_utc": "2026-10-23T17:00:00Z",
            "time_zone": "America/New_York",
            "kickoff_utc": "2026-10-23T17:00:00Z",
            "time_confirmed": true,
            "source_state": "pre",
            "received_at": null
          }
        ]
      },
      "expected": {
        "version": 1,
        "results": [
          {
            "id": "future",
            "day_index": 0,
            "bucket": "today",
            "in_window": true,
            "in_focus": true,
            "source_in_progress": false,
            "recent_live_receipt": false
          },
          {
            "id": "kickoff",
            "day_index": 0,
            "bucket": "live",
            "in_window": true,
            "in_focus": true,
            "source_in_progress": false,
            "recent_live_receipt": false
          }
        ]
      },
      "because": "A future confirmed fixture is in focus; reaching kickoff changes placement without inventing an in-progress observation."
    },
    {
      "id": "inclusive-125-minute-composition",
      "request": {
        "version": 1,
        "operation": "fixture_window",
        "cases": [
          {
            "id": "before",
            "now_utc": "2026-10-23T16:59:59.999999Z",
            "time_zone": "America/New_York",
            "kickoff_utc": "2026-10-23T14:55:00Z",
            "time_confirmed": true,
            "source_state": "pre",
            "received_at": null
          },
          {
            "id": "exact",
            "now_utc": "2026-10-23T17:00:00Z",
            "time_zone": "America/New_York",
            "kickoff_utc": "2026-10-23T14:55:00Z",
            "time_confirmed": true,
            "source_state": "pre",
            "received_at": null
          },
          {
            "id": "after",
            "now_utc": "2026-10-23T17:00:00.000001Z",
            "time_zone": "America/New_York",
            "kickoff_utc": "2026-10-23T14:55:00Z",
            "time_confirmed": true,
            "source_state": "pre",
            "received_at": null
          }
        ]
      },
      "expected": {
        "version": 1,
        "results": [
          {
            "id": "before",
            "day_index": 0,
            "bucket": "live",
            "in_window": true,
            "in_focus": true,
            "source_in_progress": false,
            "recent_live_receipt": false
          },
          {
            "id": "exact",
            "day_index": 0,
            "bucket": "live",
            "in_window": true,
            "in_focus": true,
            "source_in_progress": false,
            "recent_live_receipt": false
          },
          {
            "id": "after",
            "day_index": 0,
            "bucket": "earlier",
            "in_window": true,
            "in_focus": false,
            "source_in_progress": false,
            "recent_live_receipt": false
          }
        ]
      },
      "because": "The inclusive focus branch wins before the inner bucket boundary: exactly 125 minutes remains live, one microsecond later becomes earlier."
    },
